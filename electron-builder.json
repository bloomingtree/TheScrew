{
  "appId": "com.luosiding.app",
  "productName": "螺丝帽",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist-electron/**/*",
    "dist/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "electron/main/python",
      "to": "python",
      "filter": "**/*"
    }
  ],
  "extraFiles": [
    {
      "from": ".config",
      "to": ".config",
      "filter": [
        "**/*",
        "!data/conversations.json",
        "!data/workspaces.json",
        "!data/attachments/**",
        "!data/scheduler/**",
        "!credentials/**",
        "!bin/officecli.exe",
        "!bin/officecli.exe.old",
        "!bin/officecli.exe.old2"
      ]
    }
  ],
  "win": {
    "icon": "build/icon.png",
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "sign": null,
    "signAndEditExecutable": false
  },
  "extraMetadata": {
    "main": "dist-electron/main/index.js"
  }
}
